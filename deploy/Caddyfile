{
	admin off
	persist_config off
}

# Internal HTTP only. The shared Blossom proxy terminates public HTTPS.
:80 {
	root * /srv/site
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Asset URLs carry the release as ?v=<tag> and never change. Browsers
	# check everything else, the pages included, on each use.
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@unversioned not query v=*
	header @unversioned Cache-Control "no-cache"

	# /impressum also serves impressum.html
	try_files {path} {path}.html
	file_server
}
